
#include <stdio.h>

int main() {
    int n, i;

    printf("Enter number of frames: ");
    scanf("%d", &n);

    for(i = 1; i <= n; i++) {
        printf("\nSending Frame %d", i);
        printf("\nAcknowledgement received");
    }

    printf("\n\nAll frames sent successfully.");
    return 0;
}
